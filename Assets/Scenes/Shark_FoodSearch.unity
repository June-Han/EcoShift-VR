  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 583518376}
  sentences:
  - "Watch out \u2014 that\u2019s discarded fishing gear, also known as \u2018ghost
    nets.\u2019"
  - 'Blue Sharks are one of the most frequently caught bycatch species in the world,
    often entangled in longlines and drift nets set for tuna and swordfish.

'
  - 'Interacting with ghost nets often left blue sharks with injuries that often
    leads to death.  '
  - 3 points has been deducted as penalty. Reaching less than 0 will result in a
    Game Over!
  triggerOnce: 0
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
