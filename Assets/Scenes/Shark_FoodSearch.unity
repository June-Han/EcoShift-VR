  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 583518376}
  sentences:
  - Welcome to the open ocean!
  - You are a Blue Shark, one of the most widespread yet increasingly threatened
    shark species on Earth.
  - "Let\u2019s hunt for food! Blue Sharks are sleek, long-distance hunters that
    feed on squid, fish, and smaller sharks.\r\n"
  - 'Look for a school of fish, swim close and click the right trigger to eat!

'
  triggerOnce: 1
  triggerOnStart: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
