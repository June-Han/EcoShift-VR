  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 583518376}
  sentences:
  - "Blue Sharks are built for endurance \u2014 their long pectoral fins act like
    glider wings, letting them cruise vast distances with minimal effort. "
  - 'Blue Sharks detect prey using electroreceptors called ampullae of Lorenzini.
    They function like the green arrows which serve to guide you towards potential
    prey. '
  - Ypu can eat any fish that you see, but be careful what you eat!Continue hunting
    until we get 10 fishes!
  triggerOnce: 1
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
