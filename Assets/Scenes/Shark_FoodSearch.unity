--- !u!114 &1057548570
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1057548568}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 583518376}
  sentences:
  - "Careful! Blue Sharks have been found with microplastics and heavy metals like
    mercury accumulated in their tissue. \r\n"
  - "As a top predator, toxins biomagnify through every level of the food chain \u2014
    eventually reaching humans who consume seafood."
  - 'Blue sharks are increasingly ingesting ocean litter, including plastics, due
    to their curious nature and role as opportunistic predators. '
  - This leads to digestive damage, starvation and disruption shark's metabolism
    and reproductive functions.
  - 3 points have been deducted as penalty. Reaching less than 0 will result in a
    Game Over!
  triggerOnce: 0
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
