  dialogueManager: {fileID: 1337003607}
  sentences:
  - 'Oh no. It looks like humans left some litter behind. '
  - "Pangolins have very specialised diets and struggle to switch to other food sources.
    \r\n"
  - "Unfortunately, pangolin feeding grounds are affected by human activity and habitat
    degradation. \r\n"
  triggerOnce: 1
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
