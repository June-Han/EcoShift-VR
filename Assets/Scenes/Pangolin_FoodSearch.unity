  dialogueManager: {fileID: 1337003607}
  sentences:
  - Welcome to the embodied animal experience!
  - You are a Sunda Pangolin, a critically endangered species native to Southeast
    Asia.
  - "Let\u2019s look for food! Sunda Pangolins look for termite mounds and feed on
    insects. Look for a termite mound.\r\n"
  triggerOnce: 1
  triggerOnStart: 1
