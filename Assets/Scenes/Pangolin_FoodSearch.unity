  dialogueManager: {fileID: 1337003607}
  sentences:
  - "Congrats! You have found enough food. \r\n"
  - "Fun fact: pangolins are able to devour up to 200,000 insects every day! As such,
    pangolins are an important ecosystem regulator. \r\n"
  triggerOnce: 1
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
