  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 1337003607}
  sentences:
  - 'Oh no. It looks like humans left some litter behind. '
  - "Pangolins have very specialised diets and struggle to switch to other food sources.
    \r\n"
  - "Unfortunately, pangolin feeding grounds are affected by human activity and habitat
    degradation. \r\n"
  triggerOnce: 1
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1241188065}
        m_TargetAssemblyTypeName: FloatingArrow, Assembly-CSharp
        m_MethodName: DeactiveArrow
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
      - m_Target: {fileID: 952875033}
        m_TargetAssemblyTypeName: FloatingArrow, Assembly-CSharp
        m_MethodName: DeactiveArrow
        m_Mode: 1
