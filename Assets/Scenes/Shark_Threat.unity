--- !u!114 &419200487
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 419200485}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 566693109}
  sentences:
  - "Listen\u2026 hear that rumbling? Those are the engines of commercial fishing
    boats overhead. The noise disrupts how marine animals communicate, navigate,
    and find food."
  - "These trawlers drag massive nets through the water to catch fish \u2014 but
    sharks, dolphins, turtles, and other ocean life get swept up too. This is called
    bycatch, and it\u2019s one of the greatest threats to marine biodiversity."
  - Blue Sharks are one of the most frequently caught bycatch species in the world.
    An estimated 20 million are killed each year, most of them unintentionally.
  - "The fishermen above are casting their nets down. Dodge them! If you get caught
    three times, it\u2019s game over. Survive until the boats move on!"
  triggerOnce: 1
  triggerOnStart: 1
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1919250429}
        m_TargetAssemblyTypeName: SharkThreatIntro, Assembly-CSharp
        m_MethodName: StartIntroSequence
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
