  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 0}
  sentences:
  - Oh no, you are caught in the fishing nets! Bycatch like this is a serious threat
    to blue shark populations around the world.
  - Bycatch is the unintentional capture of non-target species in fishing gear. Blue
    sharks are one of the most frequently caught bycatch species worldwide, with
    millions caught each year.
  - We can help reduce bycatch by choosing sustainably sourced seafood, supporting
    fisheries that use shark-safe gear, and spreading awareness about bycatch.
  - The experience is over. You may remove your headset and speak to the administrators
    for further instructions. Thank you!
  triggerOnce: 0
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls: []
