  m_Script: {fileID: 11500000, guid: fbc49ac456e944f08d083b3a9f47dde3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTrigger
  dialogueManager: {fileID: 851848416}
  sentences:
  - "Oh no, it seems like the poacher caught another pangolin\u2026"
  - 'Pangolins are high demand animals on the global black market. They are poached
    for their scales and other body parts for use in traditional medicine in China,
    Vietnam and Africa. There is no scientific evidence of them having any health
    benefits.

'
  - "Between 1999 and 2017, there were about 200,000 pangolins involved in illegal
    trade. The pangolin population is declining at an alarming rate. \n"
  - Thanks for playing! Please fill in the post-experience survey.
  triggerOnce: 1
  triggerOnStart: 0
  onDialogueFinished:
    m_PersistentCalls:
      m_Calls:
